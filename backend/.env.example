# FoodHeroes backend settings: a TEMPLATE. It contains no real values.
#
# Don't fill this file in. Copy it OUTSIDE the repository, make the copy
# private, and edit the copy:
#
#     cp .env.example ~/FoodHeroes-data/foodheroes.env
#     chmod 600 ~/FoodHeroes-data/foodheroes.env
#
# Then run every backend command through it, from backend/:
#
#     python -m scripts.with_env ~/FoodHeroes-data/foodheroes.env -- python -m uvicorn app.main:app
#
# Format: KEY=value, one per line. No `export`, no $VARIABLES, no ~ (write
# full paths). Lines starting with # are ignored. Full guide:
# docs/CONFIGURATION.md

# Required. The live database, as a FULL path (sqlite: plus four slashes).
# There is no default: the backend refuses to start without it.
DATABASE_URL=sqlite:////REPLACE/WITH/FULL/PATH/TO/FoodHeroes-data/foodheroes.db

# Required: the key that signs logins. Recommended: keep it in its own private
# file and point to that file. Create one with:
#     ( umask 077; python3 -c "import secrets; print(secrets.token_urlsafe(48))" > ~/FoodHeroes-data/secret_key )
SECRET_KEY_FILE=/REPLACE/WITH/FULL/PATH/TO/FoodHeroes-data/secret_key
# Or put the key itself here instead (then delete SECRET_KEY_FILE above).
# Never paste a real key into this template or anywhere in the repository.
# SECRET_KEY=

# Optional. How long a login lasts, in minutes (5 to 720). Default 480 (8 hours).
TOKEN_MINUTES=480

# Optional. The exact website address(es) allowed to call the API, comma
# separated, no trailing slash. Default http://localhost:5173 (the Vite dev server).
FRONTEND_ORIGINS=http://localhost:5173

# Optional. Total cartons at or below which a product shows a low-stock alert. Default 10.
# LOW_STOCK_THRESHOLD=10
